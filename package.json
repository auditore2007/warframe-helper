{
  "name": "warframe-helper",
  "productName": "Warframe Helper",
  "version": "1.2.0",
  "description": "Справочник и помощник по Warframe: гайды, фарм, звёздная карта, живой статус мира и трекер мастерства",
  "author": "lenoxolen",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "build": {
    "appId": "com.lenoxolen.warframehelper",
    "productName": "Warframe Helper",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ]
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/forum": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^9.5.1"
  }
}
